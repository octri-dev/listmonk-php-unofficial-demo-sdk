{
    "name": "listmonk-unofficial-sdk/sdk",
    "description": "Listmonk SDK",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "classmap": [
            "src/"
        ]
    },
    "autoload-dev": {
        "classmap": [
            "tests/"
        ]
    },
    "scripts": {
        "check-style": "php-cs-fixer fix --dry-run --diff --sequential",
        "analyse": "phpstan analyse --memory-limit=2G",
        "test": "phpunit",
        "verify": [
            "@check-style",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    }
}