{
    "name": "octri-dev/listmonk-unofficial-demo-sdk",
    "description": "Unofficial listmonk demo SDK generated by Octri from listmonk's public API specification.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://octri-zj36wftkny47.octri.dev/",
    "support": {
        "source": "https://github.com/octri-dev/listmonk-php-unofficial-demo-sdk",
        "issues": "https://github.com/octri-dev/listmonk-php-unofficial-demo-sdk/issues"
    },
    "keywords": [
        "listmonk",
        "octri",
        "sdk",
        "openapi",
        "unofficial",
        "demo"
    ],
    "require": {
        "php": ">=8.2",
        "ext-curl": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "classmap": [
            "src/"
        ]
    },
    "autoload-dev": {
        "classmap": [
            "tests/"
        ]
    },
    "scripts": {
        "check-style": "php-cs-fixer fix --dry-run --diff --sequential",
        "analyse": "phpstan analyse --memory-limit=2G",
        "test": "phpunit",
        "verify": [
            "@check-style",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
